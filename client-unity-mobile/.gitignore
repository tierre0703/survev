# Build outputs
Builds/
.utmp/

# Unity-generated / per-machine
Library/
Temp/
Obj/
Logs/
UserSettings/
MemoryCaptures/
Recordings/

# IDE
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS / crash
.DS_Store
Thumbs.db
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage

# Staged assets (large): regenerate with tools/sync-assets.ps1
Assets/StreamingAssets/img/
Assets/StreamingAssets/audio/
Assets/StreamingAssets/l10n/
Assets/StreamingAssets/fonts/

# Generated atlas output (large): regenerate with tools/build-atlas.mjs
Assets/Sprites/atlas/

# Unity .meta files for the staged/generated asset trees
Assets/StreamingAssets/img.meta
Assets/StreamingAssets/audio.meta
Assets/StreamingAssets/l10n.meta
Assets/StreamingAssets/fonts.meta
Assets/Sprites/atlas.meta

# Top-level files robocopied from client/public (regenerated by sync-assets.ps1)
Assets/StreamingAssets/*.html
Assets/StreamingAssets/*.txt
Assets/StreamingAssets/*.ico
Assets/StreamingAssets/manifest.json
Assets/StreamingAssets/*.html.meta
Assets/StreamingAssets/*.txt.meta
Assets/StreamingAssets/*.ico.meta
Assets/StreamingAssets/manifest.json.meta
# Anything at the StreamingAssets root that sync-assets.ps1 copies (dotnet-style).
Assets/StreamingAssets/*.meta
!Assets/StreamingAssets/.gitkeep

# Vendored third-party libraries: committed on purpose (offline builds).
# Only the vendoring marker is ignored, so re-fetching does not churn git.
ThirdParty/**/.vendored
# Upstream archives left next to a library by an offline fetch are transient.
ThirdParty/*.zip
